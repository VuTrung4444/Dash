local Players = game:GetService("Players")
local player = Players.LocalPlayer
local CAM = game:GetService("ReplicatedStorage"):WaitForChild("CAM")

local DASH_COOLDOWN = 0.1
getgenv().FastDashEnabled = true

local dashName = "Dash"
pcall(function()
    local info = require(CAM.Global.PlayerProfile).skill_info["Dash"]
    dashName = info.CoolDownName or "Dash"
end)

if getgenv().__fastDashConns then
    for _, c in ipairs(getgenv().__fastDashConns) do pcall(function() c:Disconnect() end) end
end
local conns = {}
getgenv().__fastDashConns = conns

local function watchSHC(shc)
    table.insert(conns, shc.ChildAdded:Connect(function(o)
        if getgenv().FastDashEnabled and o.Name == dashName and o:IsA("NumberValue") then
            task.delay(DASH_COOLDOWN, function()
                if o.Parent then o:Destroy() end
            end)
        end
    end))
end

local function watchChar(char)
    local shc = char:FindFirstChild("SHC")
    if shc then watchSHC(shc) end
    table.insert(conns, char.ChildAdded:Connect(function(c)
        if c.Name == "SHC" then watchSHC(c) end
    end))
end

if player.Character then watchChar(player.Character) end
table.insert(conns, player.CharacterAdded:Connect(watchChar))
